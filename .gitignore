# Compiled test and tool binaries sit next to their source without an extension.
/tests/*
!/tests/*.nim
!/tests/*.nims
!/tests/*.bas
!/tests/*/

# Web and server.
node_modules/
/web/game/
.vercel/
.env
.env.*

.DS_Store

# Browser automation logs.
.playwright-mcp/
